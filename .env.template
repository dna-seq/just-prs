HF_TOKEN=<your-huggingface-token>
UV_PUBLISH_TOKEN=<your-uv-publish-token>

# ── Cache ────────────────────────────────────────────────────────────
# Override the default OS cache directory (~/.cache/just-prs on Linux)
# PRS_CACHE_DIR=/path/to/cache

# ── Memory management ───────────────────────────────────────────────
# Percentage of total RAM to keep free as a safety floor (default: 10)
# PRS_MEMORY_SAFETY_PERCENT=10
# Absolute minimum safety floor in MB, used on small machines (default: 512)
# PRS_MEMORY_SAFETY_MIN_MB=512
# Fixed genotype chunk size (overrides adaptive sizing; default: auto)
# PRS_GENO_CHUNK_SIZE=
# DuckDB per-connection memory limit for pvar joins (default: 4GB)
# PRS_DUCKDB_MEMORY_LIMIT=4GB

# ── Quality scoring ──────────────────────────────────────────────────
# Quality penalty multiplier for harmonized (cross-build) PRS scores (default: 0.90).
# Harmonized scores use coordinate liftover which may introduce minor mapping errors.
# Set to 1.0 to disable the penalty entirely.
# PRS_HARMONIZED_PENALTY=0.90

# ── Reference-allele resolution ──────────────────────────────────────
# Ensembl release used to fetch the GRCh38 primary-assembly FASTA for the
# reference-allele FASTA tier (precompute-only; the assembly sequence is identical
# across releases, so any release that still hosts the file works). Default: 113.
# PRS_ENSEMBL_RELEASE=113

# ── Downloads ────────────────────────────────────────────────────────
# Concurrent download threads for bulk scoring file fetch (default: 4)
# PRS_DOWNLOAD_WORKERS=4
# Log download progress every N files (default: 100)
# PRS_DOWNLOAD_PROGRESS_EVERY=100

# ── UI (prs-ui) ──────────────────────────────────────────────────────
# Bind address and ports for the Reflex UI (default frontend 0.0.0.0:3000, backend 0.0.0.0:8000)
# PRS_UI_HOST=0.0.0.0
# PRS_UI_PORT=3000
# PRS_UI_BACKEND_PORT=8000
# Runtime data root for UI uploads; defaults to ./data from the directory
# where the launcher was invoked, so uvx runs do not write into site-packages.
# PRS_UI_DATA_DIR=./data
# Optional local VCF for `uv run preselect`; ignored by `uv run start`.
# PRS_UI_PRESELECT_VCF=
# Optional startup query for `uv run preselect`, e.g. diabetes.
# Matches PGS ID, score name, reported trait, and EFO trait.
# PRS_UI_PRESELECT_QUERY=

# Hugging Face dataset of published public-genome PRS (Anton, Livia, o-family)
# plus catalog-level evidence tables (traits, papers, guidelines).
# Used by `prs compute --precomputed auto` / PRSCatalog when identity+profile match.
# PRS_SAMPLE_SCORES_REPO=just-dna-seq/prs-sample-scores
# Set to 0 to skip OLS / Europe PMC / guideline URL confirmation in
# `uv run pipeline evidence` (uses local catalog + cached adapters only).
# PRS_EVIDENCE_ALLOW_NETWORK=1
# Set to 0 to fail closed if a pinned integration source is not already staged.
# PRS_INTEGRATION_ALLOW_NETWORK=1
# Optional override of the integration publish parent commit (default: pinned
# runtime/evidence HEAD 1248dc9223f131c953af8d90a08e2472685d8fec).
# PRS_INTEGRATION_PARENT_COMMIT=

# ── Pipeline (prs-pipeline) ─────────────────────────────────────────
# Dagster UI host and port (default: 0.0.0.0:3010)
# PRS_PIPELINE_HOST=0.0.0.0
# PRS_PIPELINE_PORT=3010
# Reference panel: "1000g" or "hgdp_1kg" (default: 1000g)
# PRS_PIPELINE_PANEL=1000g
# Comma-separated PGS IDs to score (default: all available)
# PRS_PIPELINE_TEST_IDS=
# Log progress every N items on long batch jobs (default: 10). Hours-long
# jobs (public_sample_scores_job, reference_scores) must honor this in the
# Dagster compute log — start/end lines alone are not enough.
# PRS_PIPELINE_PROGRESS_EVERY=10
# Override the startup sensor's target job (default: full_pipeline)
# PRS_PIPELINE_STARTUP_JOB=full_pipeline
# Public sample scores + canary quarantine (pipeline sample-scores; alias: canary-audit). Prefer CLI --vcf / --pgs-ids / --limit.
# PRS_CANARY_VCFS=          # JSON [{label,path}] or comma-separated label=path (set by --vcf)
# PRS_CANARY_PGS_IDS=       # comma-separated; default entire catalog
# PRS_CANARY_LIMIT=         # pilot: first N catalog IDs
# PRS_CANARY_BUILD=         # default: auto-detect per VCF
# PRS_CANARY_ANCESTRY=EUR
# PRS_CANARY_RESULTS=       # extra result JSON paths, comma-separated
# PRS_CANARY_MIN_SAMPLES=   # default: majority of --vcf samples (3 → 2)
# PRS_CANARY_MIN_ABS_Z=6.0
# PRS_CANARY_MAX_MATCH_RATE=0.50
# Worker RSS budget for public sample scoring (percent of RAM; default 65).
# DuckDB's per-connection cap subtracts the already-resident universe + safety floor.
# PRS_SAMPLE_SCORE_MEMORY_PERCENT=65
# Optional explicit worker RSS cap in GB (overrides the percent).
# PRS_SAMPLE_SCORE_MEMORY_LIMIT_GB=
# PGS IDs per atomic checkpoint part (default 10).
# PRS_SAMPLE_SCORE_CHECKPOINT_SIZE=10
# DuckDB scoring-file rows per join chunk. Huge scores (PGS005172–PGS005197,
# ~9.5M variants) join in bounded slices instead of one native-crashing LEFT
# JOIN of the whole file. Unset means auto-sized from available RAM between
# 250000 and 2000000 rows; set this to pin an exact chunk.
# PRS_SCORING_JOIN_CHUNK_SIZE=
# Variant count that forces a singleton public-sample checkpoint (default 1M).
# The worker recycles after such a score only when process-tree RSS reaches
# PRS_SAMPLE_SCORE_LARGE_RECYCLE_RSS_GB (default 8). Set 0 to recycle after
# every large score (old behavior — froze a laptop at ~1.7 GB RSS).
# PRS_SAMPLE_SCORE_LARGE_VARIANT_THRESHOLD=1000000
# PRS_SAMPLE_SCORE_LARGE_RECYCLE_RSS_GB=8
# Parent worker concurrency (default 1; PGS-major phases stay serial).
# PRS_SAMPLE_SCORE_WORKERS=1
# Set 1 to score checkpoints in-process (tests only).
# PRS_SAMPLE_SCORE_INPROCESS=0
# Re-score failed public-sample checkpoint rows on resume, and still continue
# into uncached PGS IDs. Successful cached scores are kept. Set by
# `pipeline sample-scores --retry-failed`.
# PRS_SAMPLE_SCORE_RETRY_FAILED=0
# Quarantine checkpoint parts whose ok rows fail numeric invariants or whose
# scoring fingerprints drifted from the current scoring snapshot, then rescore
# only those parts. Unlike --retry-failed, this repairs invalid rows still
# marked ok. Set by `pipeline sample-scores --repair-invalid`.
# PRS_SAMPLE_SCORE_REPAIR_INVALID=0
# Process-tree RSS sample interval in seconds (default 1).
# PRS_MEMORY_SAMPLE_INTERVAL=1
# plink2 binary for the ancestry-model build (BUILD-TIME ONLY; runtime never needs it).
# Resolved as PLINK2_BIN > PATH > <cache>/plink2/plink2.
# PLINK2_BIN=/usr/bin/plink2
# Limit which panels/builds the ancestry-model pipeline builds (default: both panels x both builds)
# PRS_ANCESTRY_PANELS=1000g,hgdp_1kg
# PRS_ANCESTRY_BUILDS=GRCh38,GRCh37
# Force the sensor to submit a job even if all assets are materialized
# (set automatically by `pipeline run` and `pipeline catalog`; do not set manually)
# PRS_PIPELINE_FORCE_RUN=1

# ── AI assistant prefill links ───────────────────────────────────────
# Max prompt characters for each AI assistant's prefill URL *and* for `prs prompt`.
# `prs prompt --assistant claude|chatgpt|perplexity|grok|other` uses the matching budget
# (`other` is the agentic default: full prompt on stdout, no URL encoding).
# Three format tiers: <1500 = compact (150 words), 1500-2999 = full structure,
# >=3000 = full structure + quality methodology + scoring methodology.
# Higher values give the AI more context but may hit browser URL limits (~8KB encoded).
# PRS_AI_CHATGPT_MAX_CHARS=3000
# PRS_AI_CLAUDE_MAX_CHARS=6000
# PRS_AI_PERPLEXITY_MAX_CHARS=3000
# PRS_AI_GROK_MAX_CHARS=3000
# PRS_AI_OTHER_MAX_CHARS=6000

# ── Pipeline robustness ──────────────────────────────────────────────
# Minimum coverage ratio (scored/total) before warning on HF upload (default: 0.90)
# PRS_PIPELINE_MIN_COVERAGE=0.90
# Max consecutive retries for the same set of failed PGS IDs (default: 3)
# PRS_PIPELINE_MAX_FAILURE_RETRIES=3

# ── LD-proxy pipeline ────────────────────────────────────────────────
# Max worker threads for LD computation (default: 1, conservative)
# PRS_LD_MAX_WORKERS=1
# LD proxy builds use one parquet per PGS ID. Full-catalog coverage is built
# by a resumable per-PGS batch, not one catalog-wide union table.
# Use a small PGS-ID limit first; set PRS_LD_FULL_CATALOG=1 intentionally.
# PRS_LD_LIMIT_TARGETS=100
# PRS_LD_FULL_CATALOG=0
# Enable LD-specific gap/retry sensors for full-catalog automation (default off).
# PRS_LD_ENABLE_SENSORS=0
# Cooperative RSS limit for LD proxy build. If unset, uses percent below.
# PRS_LD_MEMORY_LIMIT_GB=16
# Cooperative RSS limit as percent of total RAM (default: 65)
# PRS_LD_MEMORY_LIMIT_PERCENT=65
# Untyped target positions per submitted batch (default: 10000)
# Lower this first if ld-proxy approaches the memory guard.
# PRS_LD_TARGET_BATCH_SIZE=5000
# Max target variants per in-memory correlation chunk (default: 256)
# PRS_LD_MAX_TARGETS_PER_CHUNK=128
# Max genomic span in bp per in-memory target chunk (default: 250000)
# PRS_LD_CHUNK_SIZE_BP=250000
# DuckDB memory limit for LD staging queries (falls back to PRS_DUCKDB_MEMORY_LIMIT)
# PRS_LD_DUCKDB_MEMORY_LIMIT=4GB
# BLAS threads per numpy matmul call (default: 1; higher wastes CPU on small matrices)
# PRS_LD_BLAS_THREADS=1

# --- Cache hygiene ---
# The scores cache is parquet-only: each .txt.gz is discarded once its parquet is
# verified readable. Audit any cache with `prs cache report` (read-only).
# Retain the reference-panel .tar.zst after extraction (debugging only; costs 22 GB
# across both panels). Default 0 — the archive is discarded once the panel validates.
# PRS_KEEP_PANEL_TARBALL=0
